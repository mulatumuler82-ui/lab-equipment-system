-- Create database
CREATE DATABASE IF NOT EXISTS lab_equipment_db;
USE lab_equipment_db;

-- Users table
CREATE TABLE users (
    id INT AUTO_INCREMENT PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    role ENUM('system_admin', 'lab_assistant', 'department_head', 'user', 'store_manager') NOT NULL,
    full_name VARCHAR(100),
    department VARCHAR(100),
    phone VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    is_active BOOLEAN DEFAULT TRUE
);

-- Laboratories table
CREATE TABLE laboratories (
    id INT AUTO_INCREMENT PRIMARY KEY,
    lab_name VARCHAR(100) NOT NULL,
    location VARCHAR(200),
    capacity INT,
    department VARCHAR(100),
    is_available BOOLEAN DEFAULT TRUE
);

-- Equipment table
CREATE TABLE equipment (
    id INT AUTO_INCREMENT PRIMARY KEY,
    equipment_name VARCHAR(100) NOT NULL,
    description TEXT,
    category VARCHAR(50),
    serial_number VARCHAR(100) UNIQUE,
    lab_id INT,
    status ENUM('available', 'checked_out', 'maintenance', 'reserved', 'damaged') DEFAULT 'available',
    purchase_date DATE,
    last_maintenance DATE,
    next_maintenance DATE,
    FOREIGN KEY (lab_id) REFERENCES laboratories(id)
);

-- Booking requests table
CREATE TABLE booking_requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    equipment_id INT,
    booking_date DATE NOT NULL,
    return_date DATE NOT NULL,
    purpose TEXT,
    status ENUM('pending', 'approved', 'rejected', 'completed', 'cancelled') DEFAULT 'pending',
    approved_by INT,
    approved_date DATETIME,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id),
    FOREIGN KEY (equipment_id) REFERENCES equipment(id),
    FOREIGN KEY (approved_by) REFERENCES users(id)
);

-- Maintenance reports table
CREATE TABLE maintenance_reports (
    id INT AUTO_INCREMENT PRIMARY KEY,
    equipment_id INT,
    reported_by INT,
    issue_description TEXT NOT NULL,
    priority ENUM('low', 'medium', 'high', 'critical') DEFAULT 'medium',
    status ENUM('reported', 'in_progress', 'completed', 'cancelled') DEFAULT 'reported',
    reported_date TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    completed_by INT,
    completed_date DATETIME,
    solution_details TEXT,
    FOREIGN KEY (equipment_id) REFERENCES equipment(id),
    FOREIGN KEY (reported_by) REFERENCES users(id),
    FOREIGN KEY (completed_by) REFERENCES users(id)
);

-- Check in/out log
CREATE TABLE equipment_log (
    id INT AUTO_INCREMENT PRIMARY KEY,
    equipment_id INT,
    user_id INT,
    action ENUM('check_out', 'check_in', 'reserve', 'release') NOT NULL,
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    notes TEXT,
    FOREIGN KEY (equipment_id) REFERENCES equipment(id),
    FOREIGN KEY (user_id) REFERENCES users(id)
);

-- Audit trail table
CREATE TABLE audit_trail (
    id INT AUTO_INCREMENT PRIMARY KEY,
    user_id INT,
    action VARCHAR(200) NOT NULL,
    table_name VARCHAR(50),
    record_id INT,
    old_values TEXT,
    new_values TEXT,
    ip_address VARCHAR(45),
    timestamp TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (user_id) REFERENCES users(id)
);

